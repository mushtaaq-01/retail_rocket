# Backend API Port & Host Configuration
# For local running: default port is 8088. On cloud platforms (Render/Railway/Vercel), PORT is injected automatically.
PORT=8088
HOST=0.0.0.0

# Supabase Database Configuration (Backend)
# Get these credentials from your Supabase Project Settings -> API (https://app.supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
