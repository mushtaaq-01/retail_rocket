# Frontend API Connection Configuration
# - Option A (Deploy BOTH Frontend & Backend on Vercel): Keep VITE_API_URL=/api
# - Option B (Separate Render Backend): Set VITE_API_URL=https://your-backend-app.onrender.com
# - Option C (Local Dev Server): Set VITE_API_PORT=8088
VITE_API_PORT=8088
VITE_API_URL=/api

# Vite Supabase Frontend Client Configuration
# Get these credentials from your Supabase Project Settings -> API (https://app.supabase.com)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
